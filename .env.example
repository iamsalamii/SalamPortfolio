# ==========================================
# PORTFOLIO CMS - ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port
PORT=3000
NODE_ENV=production

# Security & Sessions
JWT_SECRET=replace_with_a_super_strong_random_secret_string_minimum_32_chars
SESSION_EXPIRATION_HOURS=8

# Administrator Credentials Hash (Generated via bcrypt salt rounds 10)
ADMIN_EMAIL=salam@portfolios.com
ADMIN_PASSWORD_HASH=$2a$10$yvK3W7zP7K1V8C8A3XqRbeJ6J8u1M9w5Z2e3X4y5Z6a7B8c9D0e1F

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=

# CORS Allowed Origins (Comma separated in production, e.g. https://moussasalam.dev)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5
